{
  "name": "smartspend-app",
  "version": "1.0.0",
  "description": "SmartSpend - money tracking app with budget and AI insights",
  "main": "backend/server.js",
  "scripts": {
    "start": "npm run build:intelligence && node backend/server.js",
    "dev": "vite --config frontend/vite.config.js --host 0.0.0.0",
    "build": "vite build --config frontend/vite.config.js",
    "build:intelligence": "tsc -p tsconfig.financial-intelligence.json",
    "test:intelligence": "npm run build:intelligence && node --test backend/tests/financial-intelligence.test.js",
    "preview": "vite preview --config frontend/vite.config.js --host 0.0.0.0",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "mongoose": "^8.9.5",
    "node-fetch": "^3.3.2",
    "pinia": "^2.3.1",
    "uuid": "^9.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "prisma": "^6.19.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.7"
  }
}
