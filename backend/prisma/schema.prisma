generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BudgetPeriod {
  WEEK
  MONTH
  YEAR
}

enum ResetChannel {
  GMAIL
  FACEBOOK
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum NotificationType {
  BUDGET_OVERSPENDING
  DEBT_CARRYOVER
  SYSTEM
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  fullName     String
  birthday     DateTime?
  gender       Gender?
  phone        String?
  avatar       String?
  wallet       Decimal  @default(0) @db.Decimal(14, 2)
  sessionToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses        Expense[]
  categories      Category[]
  budget          Budget?
  categoryBudgets CategoryBudget[]
  goals           Goal[]
  passwordResets  PasswordReset[]
  notifications   Notification[]
  debtCarryovers  DebtCarryover[]
  reportExports   ReportExport[]

  @@index([email])
  @@index([sessionToken])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  categoryBudgets CategoryBudget[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  type       TransactionType @default(EXPENSE)
  title      String
  amount     Decimal  @db.Decimal(14, 2)
  date       DateTime @default(now())
  time       String?
  note       String?
  location   String?
  friends    String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
}

model Budget {
  id        String       @id @default(cuid())
  userId    String
  amount    Decimal      @db.Decimal(14, 2)
  period    BudgetPeriod @default(MONTH)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model CategoryBudget {
  id         String       @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal      @db.Decimal(14, 2)
  period     BudgetPeriod @default(MONTH)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  target    Decimal  @db.Decimal(14, 2)
  saved     Decimal  @default(0) @db.Decimal(14, 2)
  deadline  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id         String       @id @default(cuid())
  userId     String
  email      String
  channel    ResetChannel @default(GMAIL)
  codeHash   String
  resetToken String?      @unique
  verified   Boolean      @default(false)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}


model DebtCarryover {
  id                      String   @id @default(cuid())
  userId                  String
  periodKey               String
  periodLabel             String
  baseBudgetAmount        Decimal  @db.Decimal(14, 2)
  periodIncome            Decimal  @default(0) @db.Decimal(14, 2)
  periodExpense           Decimal  @default(0) @db.Decimal(14, 2)
  grossBudget             Decimal  @db.Decimal(14, 2)
  carriedDebtFromPrevious Decimal  @default(0) @db.Decimal(14, 2)
  availableBudget         Decimal  @db.Decimal(14, 2)
  debtToCarryNextPeriod   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId, periodKey])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(SYSTEM)
  title      String
  message    String
  priority   String           @default("medium")
  read       Boolean          @default(false)
  periodKey  String?
  debtAmount Decimal?         @db.Decimal(14, 2)
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([periodKey])
}

model ReportExport {
  id        String       @id @default(cuid())
  userId    String
  format    ReportFormat
  fileName  String
  periodKey String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([periodKey])
}
