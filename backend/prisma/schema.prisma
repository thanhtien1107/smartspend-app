generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BudgetPeriod {
  WEEK
  MONTH
  YEAR
}

enum ResetChannel {
  GMAIL
  FACEBOOK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  fullName     String
  birthday     DateTime?
  gender       Gender?
  phone        String?
  avatar       String?
  wallet       Decimal  @default(0) @db.Decimal(14, 2)
  sessionToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses        Expense[]
  categories      Category[]
  budget          Budget?
  categoryBudgets CategoryBudget[]
  goals           Goal[]
  passwordResets  PasswordReset[]

  @@index([email])
  @@index([sessionToken])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  categoryBudgets CategoryBudget[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  title      String
  amount     Decimal  @db.Decimal(14, 2)
  date       DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
}

model Budget {
  id        String       @id @default(cuid())
  userId    String
  amount    Decimal      @db.Decimal(14, 2)
  period    BudgetPeriod @default(MONTH)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model CategoryBudget {
  id         String       @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal      @db.Decimal(14, 2)
  period     BudgetPeriod @default(MONTH)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  target    Decimal  @db.Decimal(14, 2)
  saved     Decimal  @default(0) @db.Decimal(14, 2)
  deadline  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id         String       @id @default(cuid())
  userId     String
  email      String
  channel    ResetChannel @default(GMAIL)
  codeHash   String
  resetToken String?      @unique
  verified   Boolean      @default(false)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}
